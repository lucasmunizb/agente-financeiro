# =====================================================================
# .env.example — APENAS desenvolvimento.
# Em produção NÃO existe .env: as chaves vêm de Docker Secrets em
# /run/secrets/<nome>, lidas via variáveis *_FILE pelo entrypoint.
# Ver docs/11-devops.md (seção 12.5 do escopo).
# =====================================================================

APP_NAME="Gestao Contas IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Fuso base do produto (datas relativas e vencimentos)
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Banco (PostgreSQL 16) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=financeiro
DB_USERNAME=financeiro
DB_PASSWORD=secret
# Em produção, use DB_PASSWORD_FILE=/run/secrets/db_password (o entrypoint resolve).

# --- Credenciais do contêiner postgres (espelham DB_* acima) ---
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=secret

# --- Fila / cache / sessão no driver database (MVP, sem Redis) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Sessão/cookies (OWASP). encrypt=true cifra o payload no banco (padrão do app).
SESSION_ENCRYPT=true
# HttpOnly bloqueia leitura por JS (anti roubo de sessão via XSS).
SESSION_HTTP_ONLY=true
# SameSite mitiga CSRF.
SESSION_SAME_SITE=lax
# Secure = só trafega sob HTTPS. Em DEV (HTTP) fica false; em PRODUÇÃO é
# FORÇADO para true pelo SecurityServiceProvider (não depende deste env).
SESSION_SECURE_COOKIE=false

# --- IA: Laravel AI SDK (laravel/ai) ---
# Provedor padrão Anthropic Claude; troca por env. Failover por array de provedores.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key   # produção
# Provedor de failover (opcional):
# OPENAI_API_KEY=

# --- Telegram (webhook no próprio app) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token  # produção
TELEGRAM_WEBHOOK_SECRET=

# --- OCR (Tesseract embutido no worker) ---
OCR_DRIVER=tesseract
