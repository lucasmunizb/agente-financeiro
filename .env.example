# =====================================================================
# .env.example — APENAS desenvolvimento.
# Em produção NÃO existe .env: as chaves vêm de Docker Secrets em
# /run/secrets/<nome>, lidas via variáveis *_FILE pelo entrypoint.
# Ver docs/11-devops.md (seção 12.5 do escopo).
# =====================================================================

APP_NAME="Gestao Contas IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Fuso base do produto (datas relativas e vencimentos)
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Banco (PostgreSQL 16) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=financeiro
DB_USERNAME=financeiro
DB_PASSWORD=secret
# Em produção, use DB_PASSWORD_FILE=/run/secrets/db_password (o entrypoint resolve).

# --- Credenciais do contêiner postgres (espelham DB_* acima) ---
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=secret

# --- Fila / cache / sessão no driver database (MVP, sem Redis) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Sessão/cookies (OWASP). encrypt=true cifra o payload no banco (padrão do app).
SESSION_ENCRYPT=true
# HttpOnly bloqueia leitura por JS (anti roubo de sessão via XSS).
SESSION_HTTP_ONLY=true
# SameSite mitiga CSRF.
SESSION_SAME_SITE=lax
# Secure = só trafega sob HTTPS. Em DEV (HTTP) fica false; em PRODUÇÃO é
# FORÇADO para true pelo SecurityServiceProvider (não depende deste env).
SESSION_SECURE_COOKIE=false

# --- IA: Laravel AI SDK (laravel/ai) ---
# Provedor padrão Anthropic Claude; troca por env. Failover por array de provedores.
AI_ROTACAO_ENABLED=true
AI_PROVIDER=groq
AI_FAILOVER=groq,gemini
# Timeout HTTP por chamada de provedor (s). Curto = failover rápido / resposta instantânea.
AI_ROTACAO_POOL=groq,mistral,gemini   
AI_ROTACAO_COOLDOWN=60                         
AI_ROTACAO_STORE=database                       
AI_ROTACAO_LOCK_TTL=5
AI_REQUEST_TIMEOUT=8
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Rotação de provedores (fila LRU + cooldown, spec 04c). Desligada = failover estático.
# Só entram na rotação os provedores COM chave presente. Estado compartilhado no cache.
# Pool padrão = free tiers de texto que a SDK suporta (sem cartão): groq, mistral, gemini.
AI_ROTACAO_ENABLED=false
# AI_ROTACAO_POOL=groq,mistral,gemini             # ordem inicial da fila (free tiers)
# AI_ROTACAO_COOLDOWN=60                          # segundos benched após falha/limite
# AI_ROTACAO_STORE=database                       # store do estado (default = CACHE_STORE)
# AI_ROTACAO_LOCK_TTL=5                           # espera máxima pelo lock da seção crítica
# Chaves dos free tiers (sem a chave, o provedor sai do pool):
# GROQ_API_KEY=      # https://console.groq.com  (rápido, principal)
# MISTRAL_API_KEY=   # https://console.mistral.ai  (plano gratuito "Experiment")
# GEMINI_API_KEY=    # https://aistudio.google.com/app/apikey  (reserva: lento/503 frequente)
# OBS: Cohere NÃO entra — o driver da SDK só faz reranking/embeddings, não geração de texto.
# Ollama é só para DEV LOCAL (roda o modelo no seu hardware; inviável em VPS 2 vCPU sem GPU).
# Ex. dev: AI_ROTACAO_POOL=ollama,groq,mistral

# --- Telegram (webhook no próprio app) ---
# IMPORTANTE: use um BOT SEPARADO para dev (ex.: @SeuBotDevBot no @BotFather),
# com token próprio aqui. O webhook fica gravado no lado do Telegram, POR BOT.
# Se dev e produção compartilham o mesmo token, rodar `telegram:webhook <túnel>`
# em dev reaponta o webhook para o seu túnel e a PRODUÇÃO fica muda até alguém
# re-registrar a URL de prod. Bot de dev separado = os dois nunca brigam.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token  # produção
TELEGRAM_WEBHOOK_SECRET=

# --- OCR (Tesseract embutido no worker) ---
OCR_DRIVER=tesseract
