# =====================================================================
# Server block do Nginx do HOST para o app (stack `financeiro`).
# Fluxo: Cliente ─TLS→ Cloudflare ─TLS→ VPS:443 (este Nginx) ─proxy_pass→
#        app (127.0.0.1:8001, publicado pela stack em mode:host).
#
# Casado com o padrão que já roda neste VPS (ver bot-discord.*):
#   - real_ip da Cloudflare é GLOBAL em /etc/nginx/conf.d/cloudflare-realip.conf
#     → NÃO repetir set_real_ip_from aqui.
#   - TLS de origem com o Origin CA da Cloudflare em /etc/nginx/certs/muniz_origin.*
#     (cobre *.muniztecnologia.com.br), modo Cloudflare "Full (strict)".
#
# Instalar (como root):
#   cp este arquivo → /etc/nginx/sites-available/agentefinanceiro.muniztecnologia.com.br
#   ln -s ... /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# =====================================================================

server {
    listen 80;
    listen [::]:80;
    server_name agentefinanceiro.muniztecnologia.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name agentefinanceiro.muniztecnologia.com.br;

    ssl_certificate     /etc/nginx/certs/muniz_origin.crt;
    ssl_certificate_key /etc/nginx/certs/muniz_origin.key;

    # Faturas em PDF ficaram pós-MVP, mas mantenha um teto de upload sensato.
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8001;          # porta publicada pela stack (mode:host)
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;   # já é o IP real (real_ip global)
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;          # app confia (TRUSTED_PROXIES) → cookie Secure/URL https
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
    }
}
